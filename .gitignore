# Unversioned files and folders.
# References at https://git-scm.com/docs/gitignore.

# Finder's configuration files (Mac).
.DS_Store

# Node.js modules.
node_modules/

# Build output. Anchored to the repository root so it cannot swallow a
# directory such as `test/dist/`, which holds the artifact test suite.
/dist/
/coverage/

# Logs.
*.log
*.log.*
